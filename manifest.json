{
  "manifest_version": 3,
  "name": "Mews Reader: Private Full-Page TTS",
  "version": "1.13",
  "description": "Local-only text-to-speech powered by KittenTTS and WebGPU. Listen to web articles offline with no cloud servers and complete privacy.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "permissions": [
    "contextMenus",
    "sidePanel",
    "storage",
    "offscreen",
    "scripting",
    "activeTab",
    "notifications"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+K",
        "windows": "Alt+Shift+K",
        "mac": "Alt+Shift+K",
        "linux": "Alt+Shift+K",
        "chromeos": "Alt+Shift+K"
      }
    },
    "read_article_command": {
      "suggested_key": {
        "default": "Alt+Shift+A",
        "windows": "Alt+Shift+A",
        "mac": "Alt+Shift+A",
        "linux": "Alt+Shift+A",
        "chromeos": "Alt+Shift+A"
      },
      "description": "Read Active Page Article"
    }
  },
  "background": {
    "service_worker": "dist/background.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}