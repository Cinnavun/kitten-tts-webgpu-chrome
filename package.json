{
  "name": "Kitten-TTS-Webgpu-Chrome",
  "version": "1.13",
  "description": "Free open-source, local-first text-to-speech using KittenTTS models in browser. Select text or extract full articles, and generate audio .wav files that you can save",
  "license": "GPL-3.0",
  "author": "Cinnavun <cinnavun@icloud.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/cinnavun/kitten-tts-webgpu-chrome.git"
  },
  "homepage": "https://github.com/cinnavun/kitten-tts-webgpu-chrome",
  "keywords": [
    "text-to-speech",
    "tts",
    "webgpu",
    "privacy",
    "on-device",
    "accessibility",
    "chrome-extension"
  ],
  "bugs": {
    "url": "https://github.com/cinnavun/kitten-tts-webgpu-chrome/issues",
    "email": "Cinnavun@icloud.com"
  },
  "main": "background.js",
  "scripts": {
    "test": "node scripts/test-preprocessor.mjs && node scripts/test-article-cleaner.mjs",
    "build:esm": "esbuild src/worker.js --bundle --format=esm --sourcemap=inline --outdir=dist",
    "build:iife": "esbuild src/sidepanel.js src/offscreen.js src/extractor.js --bundle --format=iife --sourcemap=inline --outdir=dist",
    "build:assets": "node -e \"fs.copyFileSync('assets/espeak-en-dict.tsv', 'dist/espeak-en-dict.tsv'); fs.copyFileSync('assets/en_rules', 'dist/en_rules')\"",
    "build:sw": "esbuild background.js --bundle --format=esm --sourcemap=inline --outdir=dist",
    "build": "npm run build:esm && npm run build:iife && npm run build:assets && npm run build:sw",
    "build:store": "npm run build && node scripts/build-store.js",
    "zip:store": "node scripts/build-store.js --zip",
    "package:store": "npm run build:store && npm run zip:store",
    "download:models": "node scripts/download-models.mjs",
    "check": "tsc --noEmit",
    "check:watch": "tsc --noEmit --watch"
  },
  "dependencies": {
    "@mozilla/readability": "^0.6.0",
    "kitten-tts-webgpu": "^0.1.1"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.320",
    "@webgpu/types": "^0.1.72",
    "esbuild": "^0.28.1",
    "linkedom": "^0.18.13",
    "typescript": "^5.8.3"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}