{
  "name": "webgpu",
  "version": "1.1.0",
  "description": "Kitten TTS WebGPU Extension",
  "main": "background.js",
  "scripts": {
    "build:esm": "esbuild src/worker.js --bundle --format=esm --outdir=dist",
    "build:iife": "esbuild src/sidepanel.js src/offscreen.js src/extractor.js --bundle --format=iife --outdir=dist",
    "build": "npm run build:esm && npm run build:iife"
  },
  "dependencies": {
    "@mozilla/readability": "^0.6.0",
    "kitten-tts-webgpu": "^0.1.1"
  },
  "devDependencies": {
    "esbuild": "^0.28.1"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "@mozilla/readability@0.6.0": true,
    "kitten-tts-webgpu@0.1.1": true
  }
}